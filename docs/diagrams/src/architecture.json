  "cards": [
    {
      "dot": "cyan",
      "title": "生产与消费分离",
      "items": [
        "worker 是唯一调用目标账号、唯一持有目标账号凭证的服务",
        "api 只读数据、创建扫描请求，只访问 hub 账号自己的日志",
        "两个服务共用一个镜像，各自按 CPU 和内存自动扩缩"
      ]
    },
    {
      "dot": "amber",
      "title": "三种数据源",
      "items": [
        "定时扫描：Config 优先，一次查询覆盖一个区域的所有记录类型",
        "Config 覆盖不到的类型、按需扫描、单资源刷新：Cloud Control",
        "两者都不支持的类型（AMI）：EC2 自己的 API"
      ]
    },
    {
      "dot": "emerald",
      "title": "任务队列在 Postgres",
      "items": [
        "worker 用 FOR UPDATE SKIP LOCKED 领取任务",
        "定时调度在 worker 内，advisory lock 选主",
        "Redis 只做缓存，不可用时只影响速度"
      ]
    },
    {
      "dot": "rose",
      "title": "网络",
      "items": [
        "远端区域经 VPC peering 访问 interface endpoint",
        "9 个 Route 53 私有托管区把服务域名解析到远端 endpoint",
        "endpoint 策略按 aws:PrincipalOrgID 放行组织内账号的只读操作"
      ]
    }
  ]
